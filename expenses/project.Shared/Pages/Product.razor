                    @if (_calculatorTarget == "LowStockAlert" || _calculatorTarget == "StockInQty")
                    {
                        <button class="keypad-btn" style="visibility: hidden;">.</button>
                    }
                    else
                    {
                        <button class="keypad-btn" @onclick='() => AppendToAmount(".")'>.</button>
                    }
                    <button class="keypad-btn" @onclick='() => AppendToAmount("0")'>0</button><button class="keypad-btn" @onclick="BackspaceAmount">⌫</button>
                </div>
                <div style="margin-top: 1rem; display: flex; gap: 10px;">
                    <button class="btn btn-secondary" style="flex: 1;" @onclick="ClearAmount">Clear</button>
                    <button class="btn btn-primary" style="flex: 1;" @onclick="SaveAmount">Done</button>
                </div>
            </div>
        </div>
    </div>
