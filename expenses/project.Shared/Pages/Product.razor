@using project.Shared.Model
@using project.Shared.Pages

<!-- MAIN CONTAINER SWITCH: SECTION SETTINGS VS NORMAL PRODUCT VIEW -->
@if (IsSectionSettingsMode)
{
    <!-- SECTION SETTINGS MODE -->
    <div class="top-bar">
        <div class="top-bar-left">
            @if (IsAddSectionMode)
            {
                <div class="page-title">
                    <h2>@(IsEditSectionMode ? "Edit Section" : "Add Section")</h2>
                    <span>Management</span>
                </div>
            }
            else
            {
                <button class="mobile-menu-btn" @onclick="GoBackToMain">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>
                <div class="page-title">
                    <h2>Product - Section</h2>
                    <span>Management</span>
                </div>
            }
        </div>

        @if (!IsAddSectionMode)
        {
            <button class="add-btn" @onclick="OpenAddSectionMode" title="Add New Section">+</button>
        }
        else
        {
            <div style="display: flex; gap: 8px;">
                <button class="btn btn-secondary" style="border-radius: 20px; padding: 0.5rem 1rem;" @onclick="CloseAddSectionMode">Cancel</button>
                <button class="btn btn-primary" style="border-radius: 20px; padding: 0.5rem 1.5rem;" @onclick="SaveSection">Save</button>
            </div>
        }
    </div>

    <div class="content-area">
        @if (IsAddSectionMode)
        {
            <!-- ADD SECTION FORM -->
            <div class="add-mode-container" style="background: white; border-radius: 12px; padding: 2rem;">
                <div class="form-section">
                    <div class="form-group">
                        <label>Section Name</label>
                        <input type="text" class="form-control" @bind="NewSection.Name" placeholder="e.g. Mains" />
                    </div>
                    <div class="form-group">
                        <label>Additional Title</label>
                        <input type="text" class="form-control" @bind="NewSection.AdditionalTitle" placeholder="e.g. Popular Items" />
                    </div>

                    <!-- Reward Toggle -->
                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <label style="margin-bottom: 0;">Collection Reward</label>
                            <label class="switch">
                                <input type="checkbox" checked="@NewSection.IsCollectionRewardEnabled" @onchange="ToggleCollectionReward">
                                <span class="slider round"></span>
                            </label>
                        </div>
                        <span class="input-description">Set how much Credit/Point reward toward your customer upon Payment</span>
                    </div>

                    @if (NewSection.IsCollectionRewardEnabled)
                    {
                        <div style="margin-top: 1rem; display: flex; flex-direction: column; gap: 1rem;">
                            <!-- Credit Reward Input -->
                            <div class="form-group" style="display: flex; align-items: center; justify-content: space-between;">
                                <label style="margin: 0; flex: 1;">@(NewSection.IsReverseRate ? "Collection per 1.00 Credit" : "Credit per 1.00 Collection")</label>
                                <div style="position: relative; width: 150px;">
                                    <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("CreditReward"))" style="padding-right: 2.5rem; text-align: right;">
                                        <span style="color: var(--primary-rose); font-weight: bold;">@NewSection.CreditPerCollection.ToString("N2")</span>
                                    </div>
                                    <button class="icon-btn-square" @onclick="ToggleReverseRate" style="border: none; background: transparent; position: absolute; right: 2px; top: 50%; transform: translateY(-50%); width: 30px; height: 30px;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary-rose)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
                                    </button>
                                </div>
                            </div>

                            <!-- Point Reward Input -->
                            <div class="form-group" style="display: flex; align-items: center; justify-content: space-between;">
                                <label style="margin: 0; flex: 1;">@(NewSection.IsReverseRate ? "Collection per 1 Point" : "Point per 1.00 Collection")</label>
                                <div style="position: relative; width: 150px;">
                                    <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("PointReward"))" style="padding-right: 2.5rem; text-align: right;">
                                        <span style="color: var(--primary-rose); font-weight: bold;">@NewSection.PointPerCollection.ToString("N2")</span>
                                    </div>
                                    <button class="icon-btn-square" @onclick="ToggleReverseRate" style="border: none; background: transparent; position: absolute; right: 2px; top: 50%; transform: translateY(-50%); width: 30px; height: 30px;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary-rose)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- SECTION LIST -->
            <div style="padding: 1rem 1rem 0 1rem; margin-bottom: 1rem; color: #666; font-size: 0.9rem;">
                Organize SKUs by Section and Folder for better tracking. Sections or Folders with no SKUs will be hidden
            </div>
            <div class="product-list" style="padding: 0 1rem 1rem 1rem;">
                @foreach (var sec in SectionsDb)
                {
                    <div class="product-card" @onclick="() => OpenEditSectionMode(sec)" style="cursor: pointer;">
                        <div class="product-card-icon" style="background: #eef2ff; color: #6366f1;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                        </div>
                        <div class="product-details">
                            <div class="product-title">@sec.Name</div>
                            <div class="product-meta">
                                <span>@sec.FolderCount Folders</span>
                                <span>• @sec.SkuCount SKUs</span>
                                <span>• @sec.Code</span>
                            </div>
                        </div>
                        <button class="action-btn" title="Edit" @onclick:stopPropagation="true" @onclick="() => OpenEditSectionMode(sec)">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <!-- NORMAL PRODUCT VIEW -->
    <div class="top-bar">
        <div class="top-bar-left">
            <button class="mobile-menu-btn" @onclick="TriggerToggleSidebar">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>

            <div class="page-title">
                <h2>@(IsAddMode ? $"Add {ViewType}" : ViewType)</h2>
                <span>Management</span>
            </div>
        </div>

        @if (!IsAddMode)
        {
            <div style="display: flex; gap: 8px;">
                <!-- STOCK IN BUTTON -->
                <button class="add-btn" @onclick="OpenStockInMode" title="Stock In">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                </button>
                <button class="add-btn" @onclick="OpenAddProductMode" title="Add New Item">
                    +
                </button>
            </div>
        }
        else
        {
            <div style="display: flex; gap: 8px;">
                <button class="btn btn-secondary" style="border-radius: 20px; padding: 0.5rem 1rem;" @onclick="CloseAddMode">Cancel</button>
                <button class="btn btn-primary" style="border-radius: 20px; padding: 0.5rem 1.5rem;" @onclick="SaveItem">Save</button>
            </div>
        }
    </div>

    @if (!IsAddMode)
    {
        <!-- LIST VIEW -->
        <div class="action-bar-container">
            <div class="filters-bar">
                <div style="position: relative; flex: 1; min-width: 200px;">
                    <input type="text" class="search-filter-control" style="width: 100%; padding-left: 2.2rem;" placeholder="Search @ViewType..." @bind="FilterSearchQuery" @bind:event="oninput" />
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 0.8rem; top: 50%; transform: translateY(-50%);">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </div>

                <button class="icon-btn-square @(IsFilterVisible ? "active" : "")" title="Filter" @onclick="ToggleFilterVisibility">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
                </button>

                <button class="icon-btn-square" title="Download PDF" @onclick='() => DownloadReport("pdf")'>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
                </button>
                <button class="icon-btn-square" title="Settings" @onclick="OpenSectionSettings">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                </button>
            </div>

            <div class="secs-scroll-area">
                <button class="sec-btn @(SelectedSec == "All" ? "active" : "")" @onclick='() => SelectSec("All")'>All</button>
                @foreach (var sec in AvailableSecs)
                {
                    <button class="sec-btn @(SelectedSec == sec ? "active" : "")" @onclick='() => SelectSec(sec)'>@sec</button>
                }
            </div>
        </div>

        <div class="content-area">
            <div class="product-list" style="padding: 1rem;">
                @foreach (var item in FilteredItems)
                {
                    <div class="product-card">
                        @if (!string.IsNullOrEmpty(item.DisplayImageUrl))
                        {
                            <img src="@item.DisplayImageUrl" alt="@item.ItemName" class="product-card-icon" style="object-fit: fill; border: 1px solid #eee; background: #fff;" />
                        }
                        else
                        {
                            <div class="product-card-icon">@((MarkupString)GetIconForCategory(item.ProductSection))</div>
                        }

                        <div class="product-details">
                            <div class="product-title">@item.ItemName</div>
                            <div class="product-meta" style="display: block;">
                                <div>
                                    <span>@item.ProductSection</span>
                                    @if (item.Duration.HasValue)
                                    {
                                        <span> • @item.Duration min</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="product-amount-display">
                            <span>MYR @item.Price.ToString("N2")</span>
                            <button class="action-btn info-btn" title="View Details" @onclick="() => ShowItemDetails(item)">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                            </button>
                            <button class="action-btn delete-btn" @onclick="() => RequestDelete(item)" title="Delete Item">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                            </button>
                        </div>
                    </div>
                }
                @if (!FilteredItems.Any())
                {
                    <div class="empty-state">No items found for @ViewType.</div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- ADD PRODUCT INTERFACE -->
        <div class="add-mode-container">
            <!-- Top Image Adder -->
            <div class="add-image-section">
                <!-- Using double quotes for the attribute to prevent parser confusion with inner quotes -->
                <div class="image-placeholder" @onclick="OpenImageUploadPopup" style="@GetPlaceholderStyle()">
                    @if (!string.IsNullOrEmpty(_tempImagePreview))
                    {
                        <img src="@_tempImagePreview" alt="Product Image" style="width: 100%; height: 100%; object-fit: fill; border-radius: 12px;" />
                    }
                    else if (!string.IsNullOrEmpty(NewItem.DisplayImageUrl))
                    {
                        <img src="@NewItem.DisplayImageUrl" alt="Product Image" style="width: 100%; height: 100%; object-fit: fill; border-radius: 12px;" />
                    }
                    else if (string.IsNullOrEmpty(NewItem.ImageName))
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                        <span>Add Image</span>
                    }
                    else
                    {
                        <div style="font-weight: bold; color: var(--primary-rose);">@NewItem.ImageName</div>
                        <span style="font-size: 0.8rem;">Click to change</span>
                    }
                </div>
            </div>

            <!-- Tabs -->
            <div class="add-tabs">
                <button class="tab-btn @(ActiveAddTab == "Info" ? "active" : "")" @onclick='() => ActiveAddTab = "Info"'>Info</button>
                <button class="tab-btn @(ActiveAddTab == "Advance" ? "active" : "")" @onclick='() => ActiveAddTab = "Advance"'>Advance</button>
                <button class="tab-btn @(ActiveAddTab == "TC" ? "active" : "")" @onclick='() => ActiveAddTab = "TC"'>T&C</button>
            </div>

            <!-- Tab Content -->
            <div class="tab-content-area">
                @if (ActiveAddTab == "Info")
                {
                    <div class="form-section">
                        <div class="form-group">
                            <label>Name</label>
                            <input type="text" class="form-control" @bind="NewItem.ItemName" placeholder="Product Name" />
                        </div>
                        <div class="form-group">
                            <label>Section</label>
                            <div class="form-control clickable" @onclick="() => IsCategoryPopupOpen = true">
                                <span>@(string.IsNullOrEmpty(NewItem.ProductSection) ? "Select Section" : NewItem.ProductSection)</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Image URL (Folder)</label>
                            <input type="text" class="form-control" @bind="NewItem.ProductFolder" placeholder="Image Path/URL" readonly />
                        </div>

                        <div class="form-group">
                            <label>Price (MYR)</label>
                            <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("Price"))">
                                <span style="color: var(--primary-rose); font-weight: bold;">@NewItem.Price.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                }
                else if (ActiveAddTab == "Advance")
                {
                    <div class="form-section">
                        <div class="form-group">
                            <label>Barcode</label>
                            <div class="form-control clickable" @onclick="() => IsBarcodePopupOpen = true">
                                <span>@(string.IsNullOrEmpty(NewItem.Barcode) ? "Scan or Type Barcode" : NewItem.Barcode)</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left:auto; color: #888;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="8" y1="7" x2="8" y2="17"></line><line x1="12" y1="7" x2="12" y2="17"></line><line x1="16" y1="7" x2="16" y2="17"></line></svg>
                            </div>
                        </div>

                        <!-- Unit Dropdown (Custom Below Display) -->
                        <div class="form-group" style="position: relative;">
                            <label>Unit</label>
                            <!-- Using double quotes for attribute to ensure Razor parsing -->
                            <div class="form-control clickable" @onclick="ToggleUnitDropdown" style="display: flex; justify-content: space-between; align-items: center;">
                                <span>@NewItem.Unit</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(IsUnitDropdownOpen ? "transform: rotate(180deg); transition: transform 0.2s;" : "transform: rotate(0deg); transition: transform 0.2s;")"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </div>
                            @if (IsUnitDropdownOpen)
                            {
                                <div class="custom-dropdown-menu">
                                    @foreach (var unit in UnitList)
                                    {
                                        <div class="dropdown-item" @onclick="() => SelectUnit(unit)">@unit</div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Low Stock Alert -->
                        <div class="form-group">
                            <label>Low Stock Alert</label>
                            <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("LowStockAlert"))">
                                <span style="color: var(--primary-rose); font-weight: bold;">@(NewItem.LowStockAlert?.ToString() ?? "0")</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                                <label style="margin-bottom: 0;">Price Range (Min - Max)</label>
                                <label class="switch">
                                    <input type="checkbox" checked="@IsMinMaxPriceEnabled" @onchange="ToggleMinMaxPrice">
                                    <span class="slider round"></span>
                                </label>
                            </div>
                            <div class="row-group">
                                <div class="form-group" style="flex: 1;">
                                    @if (IsMinMaxPriceEnabled)
                                    {
                                        <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("MinPrice"))" style="display: flex; align-items: center; justify-content: space-between;">
                                            <span style="color: #888; font-weight: 500;">Min</span>
                                            <span style="color: var(--primary-rose); font-weight: bold;">@NewItem.MinPrice.ToString("N2")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="form-control disabled" style="display: flex; align-items: center; justify-content: space-between;">
                                            <span style="color: #aaa; font-weight: 500;">Min</span>
                                            <span>N/A</span>
                                        </div>
                                    }
                                </div>
                                <div class="form-group" style="flex: 1;">
                                    @if (IsMinMaxPriceEnabled)
                                    {
                                        <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("MaxPrice"))" style="display: flex; align-items: center; justify-content: space-between;">
                                            <span style="color: #888; font-weight: 500;">Max</span>
                                            <span style="color: var(--primary-rose); font-weight: bold;">@NewItem.MaxPrice.ToString("N2")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="form-control disabled" style="display: flex; align-items: center; justify-content: space-between;">
                                            <span style="color: #aaa; font-weight: 500;">Max</span>
                                            <span>N/A</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Outlet Availability</label>
                            <div class="form-control clickable" @onclick="() => IsOutletPopupOpen = true">
                                <span>@(SelectedOutletCodes.Any() ? $"{SelectedOutletCodes.Count} Selected" : "Select Outlets")</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left:auto;"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Free Point</label>
                            <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("FreePoint"))">
                                <span style="color: var(--primary-rose); font-weight: bold;">@NewItem.FreePoint.ToString("N0")</span>
                            </div>
                            <span class="input-description">Free point is the point given to the customer when they buy this item.</span>
                        </div>

                        <div class="form-group">
                            <label style="display: flex; justify-content: space-between; align-items: center;">
                                Redeem Point
                                <label class="switch">
                                    <input type="checkbox" checked="@IsRedeemPointEnabled" @onchange="ToggleRedeemPoint">
                                    <span class="slider round"></span>
                                </label>
                            </label>
                            @if (IsRedeemPointEnabled)
                            {
                                <div class="form-control clickable" @onclick="@(() => OpenAmountPopup("RedeemPoint"))">
                                    <span style="color: var(--primary-rose); font-weight: bold;">@NewItem.RedeemPoint.ToString("N0")</span>
                                </div>
                            }
                            else
                            {
                                <div class="form-control disabled"><span>N/A</span></div>
                            }
                            <span class="input-description">Redeem point is the point required to redeem this item.</span>
                        </div>
                    </div>
                }
                else if (ActiveAddTab == "TC")
                {
                    <div class="form-section">
                        <div class="form-group">
                            <label>Policy</label>
                            <textarea class="form-control" @bind="NewItem.Policy" rows="3" placeholder="Policy details..."></textarea>
                        </div>
                        <div class="form-group">
                            <label>Term & Conditions 1</label>
                            <input type="text" class="form-control" @bind="NewItem.TermCondition1" />
                        </div>
                        <div class="form-group">
                            <label>Term & Conditions 2</label>
                            <input type="text" class="form-control" @bind="NewItem.TermCondition2" />
                        </div>
                        <div class="form-group">
                            <label>Term & Conditions 3</label>
                            <input type="text" class="form-control" @bind="NewItem.TermCondition3" />
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

