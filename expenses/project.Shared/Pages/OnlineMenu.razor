@using project.Shared.Model

<div class="top-bar">
    <div class="top-bar-left">
        <button class="mobile-menu-btn" @onclick="TriggerToggleSidebar">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
        <div class="page-title">
            <h2>Online Menu</h2>
        </div>
    </div>

    <!-- Right Actions -->
    <div class="top-bar-right">
        <button class="icon-btn-square" title="Quick Actions" @onclick="OpenAdvancePopup">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #f39c12;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        </button>
        <button class="icon-btn-square" title="Edit">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary-rose);"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
        </button>
    </div>
</div>

<div class="content-area" style="padding: 1rem;">
    <!-- Search Bar -->
    <div style="margin-bottom: 1rem; position: relative;">
        <input type="text" class="search-filter-control" style="width: 100%; padding: 0.8rem 1rem 0.8rem 2.5rem; border-radius: 8px; border: 1px solid #e0e0e0; background: #f9f9f9;" />
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%);"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </div>

    <!-- Section Tabs (Styled like Service) -->
    <div class="secs-scroll-area" style="padding-bottom: 1rem;">
        <button class="sec-btn active" @onclick='() => SelectSection("All")'>All Section</button>
        <button class="sec-btn" @onclick='() => SelectSection("Section 1")'>Section 1</button>
    </div>

    <!-- List (Styled like CustomMenu) -->
    <div style="display: flex; flex-direction: column; gap: 1rem;">
        @foreach (var item in MenuList)
        {
            <div class="custom-menu-card" style="display: flex; align-items: center; justify-content: space-between; background: white; padding: 1.5rem; border-radius: 12px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); cursor: pointer;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: #e67e22;">
                        <!-- Using a generic icon or item specific one if available -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    </div>
                    <div>
                        <div style="font-weight: 700; font-size: 1.1rem; color: #333;">@item.ItemName</div>
                        <div style="font-size: 0.9rem; color: #888;">@item.Section</div>
                    </div>
                </div>
                <div style="text-align: right;">
                    <div style="font-weight: 700; color: var(--primary-rose);">@item.Price.ToString("F2")</div>
                    <div style="font-size: 0.85rem; color: #666;">@item.Duration</div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Advance Popup -->
@if (IsAdvancePopupOpen)
{
    <div class="modal-overlay" style="z-index: 3000;" @onclick="CloseAdvancePopup">
        <div class="modal-content" style="max-width: 400px; padding: 1.5rem;" @onclick:stopPropagation>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h3 style="margin: 0; font-size: 1.2rem; color: #333;">Advance</h3>
                <button class="close-btn" style="position: static;" @onclick="CloseAdvancePopup">&times;</button>
            </div>

            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: #555;">Menu Display</label>

                <!-- Bullet Point Selection (Radio Group) -->
                <div class="radio-group" style="display: flex; flex-direction: column; gap: 0.8rem;">
                    <label class="radio-item" style="display: flex; align-items: center; cursor: pointer; gap: 0.8rem;">
                        <input type="radio" name="menuDisplay"
                               checked="@(MenuDisplayOption == "Selected")"
                               @onchange='() => MenuDisplayOption = "Selected"'
                               style="width: 18px; height: 18px; accent-color: var(--primary-rose);" />
                        <span style="font-size: 1rem; color: #333;">Selected item ONLY</span>
                    </label>

                    <label class="radio-item" style="display: flex; align-items: center; cursor: pointer; gap: 0.8rem;">
                        <input type="radio" name="menuDisplay"
                               checked="@(MenuDisplayOption == "All")"
                               @onchange='() => MenuDisplayOption = "All"'
                               style="width: 18px; height: 18px; accent-color: var(--primary-rose);" />
                        <span style="font-size: 1rem; color: #333;">Include All Item</span>
                    </label>
                </div>

                <div style="font-size: 0.85rem; color: #888; margin-top: 0.8rem; font-style: italic;">
                    select how items will be displayed on your custom menu
                </div>
            </div>

            <button class="btn btn-primary" style="width: 100%; padding: 0.8rem; border-radius: 8px; font-weight: 600;" @onclick="SaveAdvanceSettings">Confirm</button>
        </div>
    </div>
}