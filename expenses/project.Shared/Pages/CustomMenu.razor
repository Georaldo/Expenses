@using project.Shared.Model

<!-- TOP BAR -->
<div class="top-bar">
    <div class="top-bar-left">
        <button class="mobile-menu-btn" @onclick="TriggerToggleSidebar">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
        <div class="page-title">
            <h2>@(IsAddMode ? "Add Custom Menu" : "Custom Menu")</h2>
        </div>
    </div>

    @if (!IsAddMode)
    {
        <button class="add-btn" title="Add Custom Menu" @onclick="OpenAddMode">+</button>
    }
    else
    {
        <div style="display: flex; gap: 8px;">
            <button class="btn btn-secondary" style="border-radius: 20px; padding: 0.5rem 1rem;" @onclick="CloseAddMode">Cancel</button>
            <button class="btn btn-primary" style="border-radius: 20px; padding: 0.5rem 1.5rem;" @onclick="SaveCustomMenu">Save</button>
        </div>
    }
</div>

<!-- CONTENT AREA -->
<div class="content-area" style="padding: 1rem;">
    @if (IsAddMode)
    {
        <div class="add-mode-container">
            <div class="form-section">

                <!-- ROW 1: Basic Info -->
                <div class="form-row-split">
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text" class="form-control" @bind="NewMenu.Name" placeholder="e.g. VIP Lunch Menu" />
                    </div>

                    <div class="form-group">
                        <label>Menu Items</label>
                        <div class="checkbox-group-horizontal">
                            <label class="checkbox-container">
                                <input type="checkbox" @bind="NewMenu.ShowService">
                                <span class="checkmark"></span> Service
                            </label>
                            <label class="checkbox-container">
                                <input type="checkbox" @bind="NewMenu.ShowProduct">
                                <span class="checkmark"></span> Product
                            </label>
                            <label class="checkbox-container">
                                <input type="checkbox" @bind="NewMenu.ShowPackage">
                                <span class="checkmark"></span> Package
                            </label>
                            <label class="checkbox-container">
                                <input type="checkbox" @bind="NewMenu.ShowDiscount">
                                <span class="checkmark"></span> Discount
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Menu Rules Header -->
                <h3 class="section-header">Menu Rules</h3>

                <!-- ROW 2: Member & Day -->
                <div class="form-row-split">
                    <div class="form-group">
                        <label>Applicable Member</label>
                        <div class="select-wrapper">
                            <select class="form-control" @bind="NewMenu.ApplicableMember">
                                <option value="All">All Members</option>
                                <option value="VIP">VIP</option>
                                <option value="Regular">Regular</option>
                                <option value="New">New</option>
                            </select>
                        </div>
                        <span class="input-description">select types of member who can see this custom menu</span>
                    </div>

                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                            <label style="margin-bottom: 0;">Applicable Day</label>
                            <label class="checkbox-container small" style="margin: 0;">
                                <input type="checkbox" checked="@(NewMenu.ApplicableDays.Count == 7)" @onchange="ToggleEveryday">
                                <span class="checkmark"></span> Everyday
                            </label>
                        </div>
                        <!-- Force single line for days -->
                        <div class="days-selector" style="flex-wrap: nowrap; overflow-x: auto;">
                            @foreach (var day in DaysOfWeek)
                            {
                                <button class="day-btn @(NewMenu.ApplicableDays.Contains(day) ? "active" : "")" @onclick="() => ToggleDay(day)">@day.Substring(0, 3)</button>
                            }
                        </div>
                        <span class="input-description">select which day member can see this custom menu</span>
                    </div>
                </div>

                <!-- ROW 3: Date & Time -->
                <div class="form-row-split">
                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <label style="margin-bottom: 0;">Applicable Date</label>
                            <label class="checkbox-container small" style="margin: 0;">
                                <input type="checkbox" @bind="NewMenu.IsEverydayDate">
                                <span class="checkmark"></span> Everyday
                            </label>
                        </div>

                        <!-- Padded container for Date Inputs -->
                        <div class="date-time-container">
                            @if (!NewMenu.IsEverydayDate)
                            {
                                <div class="row-group" style="width: 100%;">
                                    <input type="date" class="form-control" style="flex: 1; min-width: 0;" @bind="NewMenu.StartDate" />
                                    <span style="align-self: center;">to</span>
                                    <input type="date" class="form-control" style="flex: 1; min-width: 0;" @bind="NewMenu.EndDate" />
                                </div>
                            }
                            else
                            {
                                <div class="form-control disabled" style="width: 100%;">Any Date</div>
                            }
                        </div>
                        <span class="input-description">select which date member can see this custom menu</span>
                    </div>

                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <label style="margin-bottom: 0;">Applicable Time</label>
                            <label class="checkbox-container small" style="margin: 0;">
                                <input type="checkbox" @bind="NewMenu.IsAllDayTime">
                                <span class="checkmark"></span> All Day
                            </label>
                        </div>

                        <!-- Padded container for Time Inputs -->
                        <div class="date-time-container">
                            @if (!NewMenu.IsAllDayTime)
                            {
                                <div class="row-group" style="width: 100%;">
                                    <input type="time" class="form-control" style="flex: 1; min-width: 0;" @bind="NewMenu.StartTime" />
                                    <span style="align-self: center;">to</span>
                                    <input type="time" class="form-control" style="flex: 1; min-width: 0;" @bind="NewMenu.EndTime" />
                                </div>
                            }
                            else
                            {
                                <div class="form-control disabled" style="width: 100%;">All Day</div>
                            }
                        </div>
                        <span class="input-description">select which time member can see this custom menu</span>
                    </div>
                </div>

                <!-- ROW 4: Priority & Settings -->
                <div class="form-row-split">
                    <div class="form-group">
                        <label>Menu Priority</label>
                        <div class="select-wrapper">
                            <select class="form-control" @bind="NewMenu.Priority">
                                <option value="Highest">Highest</option>
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                                <option value="Lowest">Lowest</option>
                                <option value="None">None</option>
                            </select>
                        </div>
                        <span class="input-description">If multiple rules overlap, the one with the highest priority will be applied. Rules with no assigned priority will follow the default</span>
                    </div>

                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                            <label style="margin-bottom: 0;">Restrict to eligible menu only</label>
                            <label class="switch">
                                <input type="checkbox" @bind="NewMenu.RestrictToEligible">
                                <span class="slider round"></span>
                            </label>
                        </div>
                        <span class="input-description">By default, members can access all custom menus, Turn this on if you want to strictly limit access based on member group</span>
                    </div>
                </div>

                <!-- Enable Toggle -->
                <div class="form-group" style="margin-top: 1rem; border-top: 1px solid #eee; padding-top: 1.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <label style="margin-bottom: 0; font-size: 1.1rem; font-weight: 700;">Enable</label>
                        <label class="switch">
                            <input type="checkbox" @bind="NewMenu.IsEnabled">
                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>

            </div>
        </div>
    }
    else
    {
        <!-- LIST VIEW -->
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            @foreach (var item in MenuList)
            {
                <div class="custom-menu-card" style="display: flex; align-items: center; justify-content: space-between; background: white; padding: 1.5rem; border-radius: 12px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); cursor: pointer;">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: #e67e22;">
                            @item.Icon
                        </div>
                        <div>
                            <div style="font-weight: 700; font-size: 1.1rem; color: #333;">@item.Name</div>
                            <div style="font-size: 0.9rem; color: #888;">@item.Code</div>
                        </div>
                    </div>
                    <div style="color: #ccc;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </div>
                </div>
            }
        </div>
    }
</div>