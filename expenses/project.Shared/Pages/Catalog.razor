@using project.Shared.Model

<div class="top-bar">
    <div class="top-bar-left">
        <button class="mobile-menu-btn" @onclick="TriggerToggleSidebar">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
        <div class="page-title">
            <h2>Catalog</h2>
        </div>
    </div>
    <button class="add-btn" title="Add Catalog" @onclick="OpenSelectionMode">+</button>
</div>

<div class="content-area" style="padding: 1rem;">
    <!-- Search Bar -->
    <div style="margin-bottom: 1.5rem; position: relative;">
        <input type="text" class="search-filter-control" style="width: 100%; padding: 0.8rem 1rem 0.8rem 2.5rem; border-radius: 8px; border: 1px solid #e0e0e0; background: #f9f9f9;" />
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%);"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </div>

    <!-- Table Header -->
    <div class="catalog-header">
        <div>Item</div>
        <div>Section</div>
        <div style="text-align: right;">Redeemable</div>
        <div style="text-align: right;">Period</div>
    </div>

    <!-- List -->
    <div style="display: flex; flex-direction: column; gap: 1rem;">
        @foreach (var item in CatalogList)
        {
            <div class="custom-menu-card" style="display: grid; grid-template-columns: 2fr 1.5fr 1.5fr 1.2fr; align-items: center; padding: 1.5rem; background: white; border-radius: 12px; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">

                <!-- Item Column -->
                <div style="display: flex; align-items: center; gap: 0.8rem;">
                    <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: #888;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    </div>
                    <div>
                        <div style="font-weight: 700; font-size: 1.1rem; color: #333;">@item.ItemName</div>
                        <div style="font-size: 0.9rem; color: #666;">@item.Price.ToString("F2")</div>
                    </div>
                </div>

                <!-- Section Column -->
                <div style="font-size: 0.95rem; color: #333;">
                    @item.Section
                </div>

                <!-- Redeemable Column -->
                <div style="text-align: right; font-size: 0.95rem; color: #333;">
                    @item.RedeemableCredits.ToString("N2") Credits
                </div>

                <!-- Period Column -->
                <div style="text-align: right; font-size: 0.85rem; color: #333;">
                    <div>@item.StartDate.ToString("dd/MM/yyyy")</div>
                    <div>@item.EndDate.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        }
    </div>
</div>

<!-- SELECTION POPUP OVERLAY -->
@if (IsSelectionMode)
{
    <div class="selection-overlay">
        <div class="selection-modal">
            
            @if (SelectionStep == "List")
            {
                <!-- Modal Header -->
                <div class="modal-header">
                    <button class="close-modal-btn" @onclick="CloseSelectionMode">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                    <h3>Select items</h3>
                    <div class="header-actions">
                        <div style="position: relative;">
                            <button class="action-icon-btn" @onclick="ToggleSortMenu">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="21" y1="10" x2="3" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="21" y1="18" x2="3" y2="18"></line></svg>
                            </button>
                            
                            @if (IsSortMenuOpen)
                            {
                                <div class="sort-dropdown">
                                    <div class="sort-option" @onclick='() => SortSelection("Name")'>Name</div>
                                    <div class="sort-option" @onclick='() => SortSelection("LowPrice")'>Low Price</div>
                                    <div class="sort-option" @onclick='() => SortSelection("HighPrice")'>High Price</div>
                                </div>
                            }
                        </div>

                        <button class="action-icon-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        </button>
                    </div>
                </div>

                <!-- Tabs -->
                <div class="modal-tabs">
                    <button class="tab-btn @(CurrentSelectionTab == "Service" ? "active" : "")" @onclick='() => SwitchTab("Service")'>Service</button>
                    <button class="tab-btn @(CurrentSelectionTab == "Product" ? "active" : "")" @onclick='() => SwitchTab("Product")'>Product</button>
                </div>

                <!-- Content Scroll Area -->
                <div class="modal-content-scroll">
                    
                    <!-- Section Header -->
                    <div class="section-indicator">
                        <div class="sec-avatar">S</div>
                        <span>Section 1</span>
                    </div>

                    <!-- Grid Items -->
                    <div class="items-grid">
                        @foreach (var item in SelectionItems)
                        {
                            <div class="item-card-grid" @onclick="() => SelectItemForCatalog(item)">
                                <div class="item-icon-box">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                                </div>
                                <div class="item-info">
                                    <div class="name">@item.Name</div>
                                    <div class="price">@item.Price.ToString("F2")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (SelectionStep == "Details")
            {
                <!-- Add Catalog Header -->
                <div class="modal-header">
                    <button class="close-modal-btn" @onclick="BackToSelectionList">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    </button>
                    <h3>Add Catalog</h3>
                    <button class="save-btn-text" @onclick="SaveCatalogItem">Save</button>
                </div>

                <!-- Add Catalog Content -->
                <div class="modal-content-scroll" style="background-color: #f2f2f7;">
                    
                    <!-- Top Image Placeholder -->
                    <div style="display: flex; justify-content: center; margin: 1rem 0 2rem 0;">
                        <div class="large-icon-placeholder">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                        </div>
                    </div>

                    <!-- Segmented Control -->
                    <div class="segmented-control-container">
                        <div class="segmented-control">
                            <div class="seg-option @(AddCatalogTab == "Info" ? "active" : "")" @onclick='() => AddCatalogTab = "Info"'>Info</div>
                            <div class="seg-option @(AddCatalogTab == "Advance" ? "active" : "")" @onclick='() => AddCatalogTab = "Advance"'>Advance</div>
                        </div>
                    </div>

                    @if (AddCatalogTab == "Info")
                    {
                        <!-- Group 1: Basic Info -->
                        <div class="form-group-card">
                            <div class="form-row">
                                <label>Name</label>
                                <div class="value-display">@SelectedItem.Name</div>
                            </div>
                            <div class="form-row">
                                <label>Section</label>
                                <div class="value-display link">@SelectedItem.Section</div>
                            </div>
                            <div class="form-row last">
                                <label>Folder</label>
                                <input type="text" class="form-input-clean" placeholder="-" @bind="FormFolder" />
                            </div>
                        </div>

                        <!-- Group 2: Price -->
                        <div class="form-group-card">
                            <div class="form-row last">
                                <label>Price</label>
                                <div class="price-input-wrapper" @onclick='() => OpenCalculator("Price")'>
                                    @FormPrice.ToString("F2")
                                </div>
                            </div>
                        </div>

                        <div class="group-header">REDEEMABLE</div>
                        <div class="form-group-card">
                            <div class="form-row">
                                <label>Credit</label>
                                <div class="price-input-wrapper" @onclick='() => OpenCalculator("Credit")'>
                                    @FormCredit.ToString("F2")
                                </div>
                            </div>
                            <div class="form-row last">
                                <label>Point</label>
                                <div class="price-input-wrapper" @onclick='() => OpenCalculator("Point")'>
                                    @FormPoint
                                </div>
                            </div>
                        </div>

                        <div class="group-header">PERIOD</div>
                        <div class="form-group-card">
                            <div class="form-row">
                                <label class="link">Start Date</label>
                                <input type="date" class="form-input-clean" @bind="FormStartDate" />
                            </div>
                            <div class="form-row last">
                                <label class="link">Stop Date</label>
                                <input type="date" class="form-input-clean" @bind="FormEndDate" />
                            </div>
                        </div>
                    }
                    else if (AddCatalogTab == "Advance")
                    {
                        <div class="form-group-card" style="margin-top: 1rem;">
                            <div class="form-row">
                                <label>Display Name</label>
                                <input type="text" class="form-input-clean link-style" @bind="FormDisplayName" />
                            </div>
                            <div class="form-row">
                                <label>Display Section</label>
                                <input type="text" class="form-input-clean link-style" @bind="FormDisplaySection" />
                            </div>
                            <div class="form-row last">
                                <label>Display Folder</label>
                                <input type="text" class="form-input-clean" placeholder="Type here" @bind="FormDisplayFolder" />
                            </div>
                        </div>
                    }

                    <div style="height: 50px;"></div> <!-- Bottom Spacer -->
                </div>
            }

        </div>
    </div>
}

<!-- CALCULATOR OVERLAY -->
@if (IsCalculatorOpen)
{
    <div class="calculator-overlay" @onclick="() => IsCalculatorOpen = false">
        <div class="calculator-modal" @onclick:stopPropagation>
            <!-- Header with Title and Close -->
            <div class="calc-header">
                <button class="close-calc-btn" @onclick="() => IsCalculatorOpen = false">&times;</button>
                <div class="calc-title">@CalculatorTarget</div>
                <div style="width: 24px;"></div> <!-- Spacer for centering -->
            </div>
            
            <!-- Removed Type Switcher -->

            <!-- Display -->
            <div class="calc-display">@CalculatorDisplay</div>

            <!-- Keypad -->
            <div class="keypad-grid">
                <button class="keypad-btn" @onclick='() => CalculatorKeyPress("1")'>1</button>
                <button class="keypad-btn" @onclick='() => CalculatorKeyPress("2")'>2</button>
                <button class="keypad-btn" @onclick='() => CalculatorKeyPress("3")'>3</button>
                <button class="keypad-btn" @onclick='() => CalculatorKeyPress("4")'>4</button>
                <button class="keypad-btn" @onclick='() => CalculatorKeyPress("5")'>5</button>
                <button class="keypad-btn" @onclick='() => CalculatorKeyPress("6")'>6</button>
                <button class="keypad-btn" @onclick='() => CalculatorKeyPress("7")'>7</button>
                <button class="keypad-btn" @onclick='() => CalculatorKeyPress("8")'>8</button>
                <button class="keypad-btn" @onclick='() => CalculatorKeyPress("9")'>9</button>
                <button class="keypad-btn action" @onclick='() => CalculatorKeyPress("CLR")'>CLR</button>
                <button class="keypad-btn" @onclick='() => CalculatorKeyPress("0")'>0</button>
                
                @if (CalculatorTarget != "Point")
                {
                    <button class="keypad-btn" @onclick='() => CalculatorKeyPress(".")'>.</button>
                }
                else
                {
                    <div class="keypad-btn empty"></div> <!-- Empty spacer for alignment -->
                }
            </div>

            <button class="save-calc-btn" @onclick="ApplyCalculator">Save</button>
        </div>
    </div>
}