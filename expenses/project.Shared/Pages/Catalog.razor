@using project.Shared.Model

<div class="top-bar">
    <div class="top-bar-left">
        <button class="mobile-menu-btn" @onclick="TriggerToggleSidebar">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
        <div class="page-title">
            <h2>Catalog</h2>
        </div>
    </div>
    <button class="add-btn" title="Add Catalog">+</button>
</div>

<div class="content-area" style="padding: 1rem;">
    <!-- Search Bar -->
    <div style="margin-bottom: 1.5rem; position: relative;">
        <input type="text" class="search-filter-control" style="width: 100%; padding: 0.8rem 1rem 0.8rem 2.5rem; border-radius: 8px; border: 1px solid #e0e0e0; background: #f9f9f9;" />
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%);"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </div>

    <!-- Table Header -->
    <div class="catalog-header">
        <div>Item</div>
        <div>Section</div>
        <div style="text-align: right;">Redeemable</div>
        <div style="text-align: right;">Period</div>
    </div>

    <!-- List (Styled like CustomMenu) -->
    <div style="display: flex; flex-direction: column; gap: 1rem;">
        @foreach (var item in CatalogList)
        {
            <div class="custom-menu-card" style="display: grid; grid-template-columns: 2fr 1.5fr 1.5fr 1.2fr; align-items: center; padding: 1.5rem; background: white; border-radius: 12px; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">

                <!-- Item Column -->
                <div style="display: flex; align-items: center; gap: 0.8rem;">
                    <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: #888;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    </div>
                    <div>
                        <div style="font-weight: 700; font-size: 1.1rem; color: #333;">@item.ItemName</div>
                        <div style="font-size: 0.9rem; color: #666;">@item.Price.ToString("F2")</div>
                    </div>
                </div>

                <!-- Section Column -->
                <div style="font-size: 0.95rem; color: #333;">
                    @item.Section
                </div>

                <!-- Redeemable Column -->
                <div style="text-align: right; font-size: 0.95rem; color: #333;">
                    @item.RedeemableCredits.ToString("N2") Credits
                </div>

                <!-- Period Column -->
                <div style="text-align: right; font-size: 0.85rem; color: #333;">
                    <div>@item.StartDate.ToString("dd/MM/yyyy")</div>
                    <div>@item.EndDate.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        }
    </div>
</div>